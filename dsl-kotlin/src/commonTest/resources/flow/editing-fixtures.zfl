// Cabecera con emoji 🚚📦😀 y acentos: every offset below sits after astral characters.
/**
 * Editing fixtures for ES-P1: prove the edit model in KMP.
 *
 * Covers:
 *   - Two flows with equal command/event names (orderFlow / orderFlow2)
 *   - Repeated command bodies (authorizePayment appears in several when-blocks)
 *   - Policies with equal endpoints but different @if conditions: the two `chooseCarrier` blocks of
 *     shippingFlow have the same trigger and command and so the same occurrence key
 *   - Mixed trigger groups: OR within a group and AND between groups (shippingFlow)
 *   - Actor-start flows
 *   - Ordered calls and on-handlers
 *   - response / emits / emits-response forms
 *   - Comments and annotations preserved byte-for-byte
 *   - Parallel edges: ParcelReady reaches auditParcel through two different policies, and reaches
 *     chooseCarrier through two blocks of one key
 *   - Unicode in strings and comments, including characters outside the BMP (emoji), also on line 1
 *
 * NOTE: The ZFL grammar ID rule is [a-zA-Z_][a-zA-Z0-9_]* (ASCII only). Identifiers stay ASCII by
 *   owner decision (ZVE-R5); Unicode appears only in strings and comments.
 */

systems {
    OrderSystem {
        service OrderService
    }
    PaymentSystem {
        service PaymentService
    }
    NotificationSystem {
        service NotificationService
    }
}

/**
 * Primary order flow - place and fulfil an order.
 */
flow orderFlow {

    /** Customer submits their order. */
    @actor(Customer)
    start OrderPlaced {
        orderId String
    }

    @actor(Scheduler)
    @time("10 minutes after OrderPlaced")
    start OrderTimeout {
    }

    // When the order is placed, create it
    when OrderPlaced do createOrder {
        service OrderSystem.OrderService
        emits OrderCreated
        emits OrderFailed
    }

    // Parallel trigger origins: authorizePayment appears for two different whens
    when OrderCreated do authorizePayment {
        service PaymentSystem.PaymentService
        emits PaymentAuthorized
        emits PaymentDeclined
    }

    // NOTE: Both policies below share the same endpoint (authorizePayment) but have different conditions.
    // This tests the "two policies with equal endpoints but different conditions" requirement.
    @if("less than 3 attempts")
    when PaymentDeclined do authorizePayment {
        service PaymentSystem.PaymentService
        emits PaymentAuthorized
        emits PaymentDeclined
    }

    // Ordered calls with on-handlers (response form)
    when OrderCreated do reserveStock {
        service OrderSystem.OrderService
        call checkInventory
        on InStock emits StockReserved
        on OutOfStock response StockUnavailable
    }

    do checkInventory {
        service OrderSystem.OrderService
        response InStock
        response OutOfStock
    }

    // AND between groups: PaymentAuthorized and StockReserved
    when PaymentAuthorized and StockReserved do fulfillOrder {
        service OrderSystem.OrderService
        emits OrderFulfilled
    }

    @if("3 or more attempts")
    when PaymentDeclined do cancelOrder {
        service OrderSystem.OrderService
        emits OrderCancelled
    }

    when OrderFailed do cancelOrder {
        service OrderSystem.OrderService
        emits OrderCancelled
    }

    // emits-response form
    when OrderFulfilled do sendConfirmation {
        service NotificationSystem.NotificationService
        emits response OrderConfirmationSent
    }

    end {
        completed: OrderConfirmationSent
        cancelled: OrderCancelled
    }
}

/**
 * Second flow with intentionally equal command and event names to orderFlow.
 * Ensures that equal names in different flows never share targets (ZVE-R3).
 */
flow orderFlow2 {

    start OrderPlaced {
        orderId String
    }

    // Same command name as in orderFlow: createOrder
    when OrderPlaced do createOrder {
        service OrderSystem.OrderService
        emits OrderCreated
    }

    when OrderCreated do authorizePayment {
        service PaymentSystem.PaymentService
        emits PaymentAuthorized
    }

    when PaymentAuthorized do fulfillOrder {
        service OrderSystem.OrderService
        emits OrderFulfilled
    }

    end {
        completed: OrderFulfilled
    }
}

// Énvíos ✓ con emoji 🚚: a flow whose comments and strings are Unicode.
flow shippingFlow {

    start ParcelReady {
        parcelId String
    }

    start ParcelReturned {
        parcelId String
    }

    /** Elige transportista – «exprés» ✓ */
    @if("peso > 10 kg 📦")
    when ParcelReady do chooseCarrier {
        service OrderSystem.OrderService
        emits CarrierChosen
    }

    // Equal endpoint and trigger, different condition: same occurrence key as the block above
    @if("peso <= 10 kg — sin cargo")
    when ParcelReady do chooseCarrier {
        service OrderSystem.OrderService
        emits CarrierChosen
    }

    // OR within one group: either event triggers the notification
    when CarrierChosen | ParcelReturned do notifyCustomer {
        service NotificationSystem.NotificationService
        emits CustomerNotified
    }

    // Parallel edges: ParcelReady reaches auditParcel through two policies
    when ParcelReady do auditParcel {
        service OrderSystem.OrderService
        emits ParcelAudited
    }

    when ParcelReady and CarrierChosen do auditParcel {
        service OrderSystem.OrderService
        emits ParcelAudited
    }

    // Mixed: OR within the first group, AND between groups
    when CarrierChosen | ParcelReturned and ParcelAudited do closeParcel {
        service OrderSystem.OrderService
        emits ParcelClosed
    }

    end {
        completed: ParcelClosed
    }
}
