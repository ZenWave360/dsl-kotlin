systems {

    @zdl("orders-checkout-api/domain-model.zdl")
    OrdersCheckout {
        service OrdersCheckoutService {
            commands: startOrderCheckout, confirmOrder, cancelOrder
        }
    }
    @zdl("catalog-products-api/domain-model.zdl")
    CatalogInventory {
        service InventoryService for(StockReservation) {
            commands: reserveStock, confirStockReservation, releaseStock
        }
    }

    @zdl("payments-processing-api/domain-model.zdl")
    PaymentsProcessing {
        service PaymentsProcessingService {
            commands: authorizePayment, retryPayment, capturePayment, voidPayment
        }
    }

    @zdl("fulfillment-shipping-api/domain-model.zdl")
    FulfillmentShipping {
        service FulfillmentShippingService {
            commands: scheduleFulfillment
        }
    }

    @zdl("notifications-consumer-api/domain-model.zdl")
    NotificationsConsumer {
        service NotificationsConsumerService {
            commands: sendOrderConfirmation, sendStockUnavailableNotification, sendOrderCancelledNotification
        }
    }
}

/**
 * Place Order Flow
 *
 * Covers the full lifecycle of a customer order during a limited edition drop,
 * from the moment the customer submits their intent through payment capture and
 * shipping confirmation — or cancellation if any step fails.
 *
 * Stock reservation happens before payment. In a scarcity-driven drop, inventory
 * is the binding constraint. We hold the item first and charge second.
 *
 * Payment runs in two phases. Authorization at checkout places a hold on the
 * customer's funds without moving money. Capture happens later, at fulfillment
 * time, when the order is physically ready to ship. If fulfillment fails after
 * authorization but before capture, the hold is voided — no charge ever appears
 * on the customer's statement.
 *
 * Transient payment errors are retried within the reservation window. A hard
 * decline from the processor is not retried — it goes straight to cancellation.
 *
 * Reservation expiry is owned by the Scheduler, not the payment service. If
 * payment is not resolved within ten minutes of the order being created, the
 * Scheduler fires ReservationExpired and the stock is returned to the pool.
 */
flow PlaceOrderFlow {

    /**
     * The customer submits their intent to purchase. This is the command that
     * opens the flow. No stock is touched and no order record exists yet.
     * The system acknowledges the request by emitsting OrderRequested.
     */
    @actor(Customer)
    start StartOrderCheckout {
        items SKU[]
    }

    when StartOrderCheckout do startOrderCheckout {
        service OrdersCheckout.OrdersCheckoutService
        call reserveStock
        on StockReserved emits OrderCreated
        on StockUnavailable emits StockUnavailable
    }

    /**
     * Stock is reserved immediately on receipt of the customer's request.
     * In a limited edition drop, inventory sells out in seconds. Holding the
     * item now, before payment, is what guarantees the customer gets what they
     * came for. If stock is gone, we tell the customer immediately and stop here.
     */
    do reserveStock {
        service CatalogInventory.InventoryService
        response StockReserved
        response StockUnavailable
    }

    /**
     * We place an authorization hold on the customer's payment method. Funds
     * are reserved at the processor but not yet transferred to us. A decline
     * means the processor rejected the card outright and we will not retry —
     * the customer needs to act. A failure means a technical error on our side
     * or the processor's, which we will retry within the reservation window.
     */
    when OrderCreated do authorizePayment {
        service PaymentsProcessing.PaymentsProcessingService
        @outcome(authorized)
        emits PaymentAuthorized
        @outcome(declined)
        emits PaymentDeclined
        @failure @outcome(failed)
        emits PaymentFailed
    }

    /**
     * A technical failure during authorization is eligible for retry. We attempt
     * again within the same reservation window. If all retry attempts are spent,
     * PaymentRetryExhausted is emitsted and the order moves to cancellation.
     * PaymentRetried feeds back into authorizePayment for the next attempt.
     */
    when PaymentFailed do retryPayment {
        service PaymentsProcessing.PaymentsProcessingService
        @outcome(retried)
        emits PaymentRetried
        @outcome("retry-exhausted")
        emits PaymentRetryExhausted
    }

    when PaymentRetried do authorizePayment {
        service PaymentsProcessing.PaymentsProcessingService
        @outcome(authorized)
        emits PaymentAuthorized
        @outcome(declined)
        emits PaymentDeclined
        @outcome(failed)
        emits PaymentFailed
    }

    /**
     * Authorization succeeded. We update the order status so the rest of the
     * system knows this order is payment-backed and ready for fulfillment.
     */
    when PaymentAuthorized do confirmOrder {
        service OrdersCheckout.OrdersCheckoutService
        call confirmStockReservation
        emits OrderConfirmed
    }

    /**
     * Stock Reservation is confirmed
     */
    do confirmStockReservation {
        service CatalogInventory.InventoryService
        emits StockReservationConfirmed
    }

    /**
     * The confirmed order is handed to the fulfillment team for picking,
     * packing, and dispatch scheduling. If fulfillment cannot be arranged —
     * warehouse issue, carrier problem, item damage — we void the payment
     * authorization rather than capturing it.
     */
    when OrderConfirmed do scheduleFulfillment {
        service FulfillmentShipping.FulfillmentShippingService
        emits FulfillmentScheduled
        emits FulfillmentFailed
    }

    /**
     * Money moves here, not at checkout. We capture the authorization hold
     * only when the order is physically ready to leave our warehouse. If capture
     * fails at this point, we treat it the same as a fulfillment failure and
     * void the authorization.
     */
    when FulfillmentScheduled do capturePayment {
        service PaymentsProcessing.PaymentsProcessingService
        emits PaymentCaptured
        emits PaymentCaptureFailed
    }

    /**
     * Payment has been captured and the order is on its way. Only now do we
     * send the customer their order confirmation. Sending it earlier — at
     * authorization — would risk confirming an order we later have to cancel.
     */
    when PaymentCaptured do sendOrderConfirmation {
        service NotificationsConsumer.NotificationsConsumerService
        emits OrderConfirmationSent
    }

    /**
     * The item the customer wanted is no longer available. We notify them
     * immediately so they can look for alternatives. No payment was attempted
     * and no order record was created.
     */
    when StockUnavailable do sendStockUnavailableNotification {
        service NotificationsConsumer.NotificationsConsumerService
        emits StockUnavailableNotificationSent
    }

    /**
     * Fulfillment could not be completed after we had already authorized
     * payment. We void the authorization rather than capturing and then
     * refunding — a void is cleaner, faster, and never appears as a charge
     * on the customer's statement.
     */
    @compensates(scheduleFulfillment)
    when FulfillmentFailed, PaymentCaptureFailed do voidPayment {
        service PaymentsProcessing.PaymentsProcessingService
        emits PaymentVoided
    }

    /**
     * All terminal failure paths converge here. Whether payment was declined,
     * retries were exhausted, the authorization was voided, or the reservation
     * window expired — the outcome is the same: stock goes back to the pool.
     * The emits that triggered this step carries the reason; this operation
     * does not need to know it.
     */
    @compensates(reserveStock)
    when PaymentDeclined, PaymentRetryExhausted, PaymentVoided, ReservationExpired do releaseStock {
        service CatalogInventory.InventoryService
        emits StockReleased
    }

    /**
     * If payment is not resolved within ten minutes of the order being created,
     * the Scheduler releases the reservation automatically. This protects
     * inventory from being locked indefinitely by abandoned or stalled checkouts.
     * The timer stops as soon as payment reaches any terminal state.
     */
    @actor(Scheduler)
    @time("10 minutes after OrderCreated and not PaymentAuthorized or PaymentDeclined or PaymentRetryExhausted")
    start ReservationExpired {
        orderId String
    }

    /**
     * Once stock is released, the order has no inventory backing it and must
     * be cancelled. OrdersCheckout is the single owner of this transition —
     * no other part of the system should emits OrderCancelled directly.
     */
    @compensates(createOrder)
    when StockReleased do cancelOrder {
        service OrdersCheckout.OrdersCheckoutService
        emits OrderCancelled
    }

    /**
     * The customer is informed that their order has been cancelled and why.
     * At this point the reservation is gone, the order is closed, and no
     * payment was taken.
     */
    when OrderCancelled do sendOrderCancelledNotification {
        service NotificationsConsumer.NotificationsConsumerService
        emits OrderCancelledNotificationSent
    }

    end {
        completed: OrderConfirmationSent
        stockGone: StockUnavailableNotificationSent
        orderCancelled: OrderCancelledNotificationSent
    }
}
