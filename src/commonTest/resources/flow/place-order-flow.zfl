@import(catalog: "com.arcadia-editions.domain:catalog:RELEASE")
@import(orders: "com.arcadia-editions.domain:orders:RELEASE")
@import(payments: "com.arcadia-editions.domain:payments:RELEASE")
@import(fulfillment: "com.arcadia-editions.domain:fulfillment:RELEASE")
@import(notifications: "com.arcadia-editions.domain:notifications:RELEASE")

config {
    basePackage "io.arcadia.editions"
    persistence jpa
}

systems {
    @zdl("catalog/model.zdl")
    Catalog {
        service CatalogService
    }

    @zdl("orders/model.zdl")
    Orders {
        service OrderService
    }

    @zdl("payments/model.zdl")
    Payments {
        service PaymentService
    }

    @zdl("fulfillment/model.zdl")
    Fulfillment {
        service FulfillmentService
    }

    @zdl("notifications/model.zdl")
    Notifications {
        service NotificationService
    }
}

/**
 * Place Order Flow
 *
 * Models the full lifecycle of a customer placing an order during a limited edition drop.
 * Stock reservation comes before payment — scarcity is the core business constraint.
 * Includes compensation flows for stock unavailability, payment failure, and payment timeout.
 */
flow PlaceOrderFlow {

    @actor(Customer)
    start CustomerPlacesOrder {
        customerId String
        productId String
        quantity Integer
        paymentMethodId String
        shippingAddressId String
    }

    // Stock is reserved first — during a hot drop this is the critical constraint
    when CustomerPlacesOrder do reserveStock {
        service Catalog.CatalogService
        event StockReserved
        event StockUnavailable
    }

    when StockReserved do createOrder {
        service Orders.OrderService
        event OrderCreated
    }

    when OrderCreated do authorizePayment {
        service Payments.PaymentService
        event PaymentAuthorized
        event PaymentFailed
    }

    when PaymentAuthorized do confirmOrder {
        service Orders.OrderService
        event OrderConfirmed
    }

    when OrderConfirmed do scheduleFulfillment {
        service Fulfillment.FulfillmentService
        event FulfillmentScheduled
    }

    when FulfillmentScheduled do sendOrderConfirmation {
        service Notifications.NotificationService
        event OrderConfirmationSent
    }

    // Failure path: stock gone during a hot drop
    when StockUnavailable do sendStockUnavailableNotification {
        service Notifications.NotificationService
        event StockUnavailableNotificationSent
    }

    // Failure path: payment declined — release reserved stock
    when PaymentFailed do releaseStock {
        service Catalog.CatalogService
        event StockReleased
    }

    when StockReleased do cancelOrder {
        service Orders.OrderService
        event OrderCancelled
    }

    when OrderCancelled do sendPaymentFailedNotification {
        service Notifications.NotificationService
        event PaymentFailedNotificationSent
    }

    // Timeout path: customer started checkout but never completed payment
    @time("10 minutes after OrderCreated and not PaymentAuthorized or PaymentFailed")
    start PaymentTimeout {
        orderId String
    }

    when PaymentTimeout do releaseStock {
        service Catalog.CatalogService
        event StockReleased
    }

    end {
        completed: OrderConfirmationSent
        stockGone: StockUnavailableNotificationSent
        paymentDeclined: PaymentFailedNotificationSent
    }
}
